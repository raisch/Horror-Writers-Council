{
    "compilerOptions": {
        "target": "ES2024",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": [
            "ES2024"
        ],
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts",
        "test/**/*.ts"
    ]
}